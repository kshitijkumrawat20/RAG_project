# Never commit filled-in environment files — they hold the generated secrets.
.env
**/.env
!.env.example
!**/.env.example

# Stack-local runtime state.
unstructured-stack/data/inbox/*
unstructured-stack/data/archive/*
unstructured-stack/data/failed/*
unstructured-stack/data/state/*
anythingllm-stack/data/*
!**/.gitkeep

# Script artifacts.
anythingllm-stack/scripts/.ingest-ledger.json
anythingllm-stack/file-type-matrix.json
anythingllm-stack/fixtures/*
!anythingllm-stack/fixtures/.gitkeep

__pycache__/
*.pyc
.venv/
uv.lock
.claude
