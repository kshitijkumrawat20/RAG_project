# anythingllm-stack — copy to .env and fill in.
#   cp .env.example .env
#
# Generate every secret below with:
#   openssl rand -hex 32
#
# Inline `#` comments are not used after values on purpose — Compose reads this verbatim.

# ---------------------------------------------------------------------------
# Shared infrastructure (must match the unstructured-stack .env exactly)
# ---------------------------------------------------------------------------
SHARED_NETWORK_NAME=ai-stack-net

# Host path of the vault root. Only its `corporate/` subfolder is ever mounted, read-only.
VAULT_HOST_PATH=/srv/vault

# ---------------------------------------------------------------------------
# Container
# ---------------------------------------------------------------------------
ANYTHINGLLM_IMAGE_TAG=latest
ANYTHINGLLM_BIND_ADDRESS=127.0.0.1
ANYTHINGLLM_HOST_PORT=3001
ANYTHINGLLM_CPU_LIMIT=4
ANYTHINGLLM_MEM_LIMIT=8g
DISABLE_TELEMETRY=true

# ---------------------------------------------------------------------------
# Secrets — openssl rand -hex 32 for each. Never commit the filled-in .env.
# ---------------------------------------------------------------------------
# Signs session JWTs.
JWT_SECRET=
# Encrypts stored provider credentials. Must be >= 32 characters.
SIG_KEY=
# Salt paired with SIG_KEY. Must be >= 32 characters.
SIG_SALT=
# Single-instance login password. Leave empty for no password (only do that if the port
# is bound to 127.0.0.1 and the shared Docker network is trusted).
AUTH_TOKEN=

# Developer API key. NOT auto-generated: create it in the UI after first boot
# (Settings -> Tools -> Developer API -> Generate New API Key), then paste it here.
# Used only by scripts/allm.py and by future internal service integrations.
ANYTHINGLLM_API_KEY=

# ---------------------------------------------------------------------------
# Generation — the EXISTING local LLM container. Do not deploy a second one.
# ---------------------------------------------------------------------------
LLM_BASE_PATH=http://host.docker.internal:8000/v1

# The model id your server advertises. Check it with:
#   curl -s http://localhost:8000/v1/models | python3 -m json.tool
LLM_MODEL=CHANGE-ME-TO-YOUR-SERVED-MODEL-ID

# The local server does not validate this, but it must be a non-empty string.
LLM_API_KEY=local-no-auth

# Context window of the served model, and the cap on generated tokens per answer.
LLM_MODEL_TOKEN_LIMIT=8192
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Embeddings — separate, small, CPU-only. Never sent to LLM_BASE_PATH, never to a
# third-party API. Runs in-process inside the AnythingLLM container.
# ---------------------------------------------------------------------------
EMBEDDING_ENGINE=native
EMBEDDING_MODEL_PREF=Xenova/all-MiniLM-L6-v2

# all-MiniLM-L6-v2 truncates at 256 wordpiece tokens (~1000 English chars). Keep this at
# 1000 and keep chunks under it, or the tail of each chunk is silently dropped at embed time.
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=1000

# ---------------------------------------------------------------------------
# Chunking — must mirror unstructured-stack/.env (CHUNK_MAX_CHARACTERS / CHUNK_OVERLAP)
# so preprocessed chunks are not re-split into different boundaries here.
# ---------------------------------------------------------------------------
TEXT_SPLITTER_CHUNK_SIZE=900
TEXT_SPLITTER_CHUNK_OVERLAP=120

# Embedded, file-backed, no extra container.
VECTOR_DB=lancedb

# ---------------------------------------------------------------------------
# Used by scripts/allm.py only (not read by the container)
# ---------------------------------------------------------------------------
ANYTHINGLLM_BASE_URL=http://localhost:3001
WORKSPACE_NAME=Corporate Knowledge Base
WORKSPACE_SLUG=corporate-knowledge-base

# Where the preprocessed vault output lives, as seen by whoever runs the script.
# On the host that is $VAULT_HOST_PATH/corporate; inside a container it is /vault/corporate.
VAULT_CORPORATE_DIR=/srv/vault/corporate
