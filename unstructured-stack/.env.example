# unstructured-stack — copy to .env and fill in.
#   cp .env.example .env
#
# This stack holds NO secrets: the self-hosted Unstructured API is unauthenticated by
# design and is reachable only from the shared Docker network plus a loopback-bound
# host port. Nothing here needs `openssl rand -hex 32`.
# Inline `#` comments are not used below on purpose — Compose reads this file verbatim.

# ---------------------------------------------------------------------------
# Shared infrastructure (must match the anythingllm-stack .env exactly)
# ---------------------------------------------------------------------------
# Pre-existing external Docker network, created once by the host operator.
SHARED_NETWORK_NAME=ai-stack-net

# Host path of the vault root. Only its `corporate/` subfolder is ever mounted.
VAULT_HOST_PATH=/srv/vault

# ---------------------------------------------------------------------------
# unstructured-api
# ---------------------------------------------------------------------------
# Pin this after the first pull (see README "Pinning image versions").
UNSTRUCTURED_API_IMAGE_TAG=latest

# Host port for the API. MUST NOT be 8000 — that belongs to the existing local LLM.
UNSTRUCTURED_BIND_ADDRESS=127.0.0.1
UNSTRUCTURED_HOST_PORT=8003

# CPU inference threads. Keep modest so OCR does not starve the LLM container's host CPU.
UNSTRUCTURED_OMP_NUM_THREADS=4
UNSTRUCTURED_PARALLEL_MODE_ENABLED=false
UNSTRUCTURED_API_CPU_LIMIT=6
UNSTRUCTURED_API_MEM_LIMIT=8g

# ---------------------------------------------------------------------------
# preprocessor worker
# ---------------------------------------------------------------------------
UV_IMAGE_TAG=python3.12-bookworm-slim
PREPROCESSOR_IMAGE_TAG=1.0.0
PREPROCESSOR_CPU_LIMIT=2
PREPROCESSOR_MEM_LIMIT=2g

# Must own ./data and have write access to $VAULT_HOST_PATH/corporate.
PREPROCESSOR_UID=1000
PREPROCESSOR_GID=1000

# Polling interval for the inbox. Set ONE_SHOT=true to process the backlog once and exit.
WATCH_INTERVAL_SECONDS=20
ONE_SHOT=false

# Move successfully processed originals into ./data/archive (false = leave them in inbox).
ARCHIVE_PROCESSED=true

# Re-run a file if its sha256 changes (same filename, new content).
REPROCESS_CHANGED=true

# ---------------------------------------------------------------------------
# Partitioning
# ---------------------------------------------------------------------------
# auto | fast | hi_res | ocr_only
#   auto   -> fast for PDFs with a real text layer, hi_res when OCR is needed. Default.
#   hi_res -> layout model on every page. Best page numbers/tables, 5-20x slower on CPU.
PARTITION_STRATEGY=auto

# HTML table reconstruction (hi_res only). Costs roughly 2-4x CPU time per PDF page.
# Turn on for table-heavy financial/legal PDFs.
INFER_TABLE_STRUCTURE=false

# Tesseract language packs for OCR, comma-separated (eng, deu, fra, ...).
OCR_LANGUAGES=eng

# ---------------------------------------------------------------------------
# Chunking — sized for AnythingLLM's CPU embedder (all-MiniLM-L6-v2, 256-token window
# ~= 1000 English characters). 900 max chars keeps every chunk inside that window with
# margin, so nothing is silently truncated at embed time. Mirror any change here in the
# anythingllm-stack's TEXT_SPLITTER_CHUNK_SIZE / TEXT_SPLITTER_CHUNK_OVERLAP.
# ---------------------------------------------------------------------------
# by_title | basic | none
CHUNKING_STRATEGY=by_title
CHUNK_MAX_CHARACTERS=900
CHUNK_NEW_AFTER_N_CHARS=750
CHUNK_OVERLAP=120
CHUNK_COMBINE_UNDER_N_CHARS=250

# Per-file API timeout. A 300-page scanned PDF at hi_res can genuinely take ~20 minutes.
REQUEST_TIMEOUT_SECONDS=1800

LOG_LEVEL=INFO
